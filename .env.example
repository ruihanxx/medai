# Used only when --provider codex is selected.
MEDAI_CODEX_MODEL=gpt-5.6-terra
MEDAI_CODEX_REASONING_EFFORT=high

# Used only when --provider codex-siliconflow is selected.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
CODEX_CLI_SILICONFLOW_MODEL=
CODEX_CLI_SILICONFLOW_CONTEXT_WINDOW=131072
CODEX_CLI_SILICONFLOW_REASONING_EFFORT=
CODEX_CLI_TIMEOUT_SECONDS=1200

# Optional remote-compute selection. Leave both values empty for local-only
# runs. Provider-specific variables belong only in the selected runtime skill's
# `providers/<provider>.json` metadata and reference document.
MEDAI_COMPUTATION_PROVIDER=
MEDAI_DRIVE_PROVIDER=

# Optional path inside the copied ~/.ssh directory for key-first remote login.
COMPUTATION_PROVIDER_SSH_IDENTITY_FILE=
