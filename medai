#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE_NAME="${MEDAI_IMAGE:-medai:local}"

paper=""
repo=""
data=""
provider="codex"
siliconflow_config=""
requested_output=""
forwarded=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --paper)
            paper="$(realpath "$2")"
            shift 2
            ;;
        --repo)
            repo="$(realpath "$2")"
            shift 2
            ;;
        --data)
            data="$(realpath "$2")"
            shift 2
            ;;
        --output)
            if [[ $# -lt 2 ]]; then
                echo "ERROR: --output requires a run directory" >&2
                exit 2
            fi
            requested_output="$2"
            if [[ -z "$requested_output" ]]; then
                echo "ERROR: --output requires a run directory" >&2
                exit 2
            fi
            shift 2
            ;;
        --output=*)
            requested_output="${1#--output=}"
            if [[ -z "$requested_output" ]]; then
                echo "ERROR: --output requires a run directory" >&2
                exit 2
            fi
            shift
            ;;
        --provider)
            provider="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"
            shift 2
            ;;
        --siliconflow-config)
            siliconflow_config="$(realpath "$2")"
            shift 2
            ;;
        --help|-h)
            cat <<'EOF'
Usage: ./medai --paper PAPER.pdf --provider PROVIDER [options]

Options:
  --repo DIR
  --data DIR
  --siliconflow-config FILE
  --codex-model MODEL
  --codex-reasoning-effort EFFORT
  --smart-replicate
  --output RUN_DIR              Resume an existing run under ./runs
  --help
EOF
            exit 0
            ;;
        *)
            forwarded+=("$1")
            shift
            ;;
    esac
done

if [[ -z "$paper" || ! -f "$paper" ]]; then
    echo "ERROR: --paper must be an existing PDF file" >&2
    exit 2
fi
if [[ -n "$repo" && ! -d "$repo" ]]; then
    echo "ERROR: --repo must be an existing directory" >&2
    exit 2
fi
if [[ -n "$data" && ! -d "$data" ]]; then
    echo "ERROR: --data must be an existing directory" >&2
    exit 2
fi
if [[ "$provider" != "claude" && "$provider" != "codex" && "$provider" != "codex-siliconflow" ]]; then
    echo "ERROR: unsupported provider: $provider" >&2
    exit 2
fi
if [[ "$provider" == "codex-siliconflow" && ( -z "$siliconflow_config" || ! -f "$siliconflow_config" ) ]]; then
    echo "ERROR: codex-siliconflow requires --siliconflow-config" >&2
    exit 2
fi
paper_name="$(basename "$paper")"
paper_name="${paper_name%.*}"
paper_name="$(printf '%s' "$paper_name" | tr -cs '[:alnum:]_.-' '_' | sed 's/^_*//; s/_*$//')"
[[ -n "$paper_name" ]] || paper_name="paper"
mkdir -p "$PROJECT_ROOT/runs"
runs_root="$(cd "$PROJECT_ROOT/runs" && pwd -P)"
if [[ -n "$requested_output" ]]; then
    if [[ ! -d "$requested_output" ]]; then
        echo "ERROR: --output must be an existing MedAI run directory" >&2
        exit 2
    fi
    output="$(cd "$requested_output" && pwd -P)"
    if [[ "$output" != "$runs_root/"* ]]; then
        echo "ERROR: --output must be an existing directory under $runs_root" >&2
        exit 2
    fi
    if [[ ! -f "$output/manifest.json" ]]; then
        echo "ERROR: --output does not contain manifest.json: $output" >&2
        exit 2
    fi
    printf 'Resuming run output: %s\n' "$output"
else
    run_prefix="$(date -u +%Y%m%dT%H%M%SZ)_${paper_name}"
    output="$runs_root/$run_prefix"
    run_suffix=1
    while ! mkdir "$output" 2>/dev/null; do
        output="$runs_root/${run_prefix}_$run_suffix"
        run_suffix=$((run_suffix + 1))
    done
    printf 'Run output: %s\n' "$output"
fi

if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
    docker build --platform linux/amd64 \
        -f "$PROJECT_ROOT/docker/Dockerfile" \
        -t "$IMAGE_NAME" \
        "$PROJECT_ROOT"
fi

docker_args=(
    --rm
    --env "MEDAI_HOST_PAPER=$paper"
    --mount "type=bind,src=$paper,dst=/workspace/inputs/paper.pdf,readonly"
    --mount "type=bind,src=$output,dst=/workspace/output"
)
cli_args=(
    --paper /workspace/inputs/paper.pdf
    --provider "$provider"
    --output /workspace/output
)

if [[ -n "$repo" ]]; then
    docker_args+=(--env "MEDAI_HOST_REPO=$repo")
    docker_args+=(--mount "type=bind,src=$repo,dst=/workspace/repo,readonly")
    cli_args+=(--repo /workspace/repo)
fi
if [[ -n "$data" ]]; then
    docker_args+=(--env "MEDAI_HOST_DATA=$data")
    docker_args+=(--mount "type=bind,src=$data,dst=/workspace/data,readonly")
    cli_args+=(--data /workspace/data)
fi
if [[ -n "$siliconflow_config" ]]; then
    docker_args+=(--mount "type=bind,src=$siliconflow_config,dst=/run/secrets/siliconflow.env,readonly")
    cli_args+=(--siliconflow-config /run/secrets/siliconflow.env)
fi
if [[ -d "${HOME}/.codex" ]]; then
    docker_args+=(--mount "type=bind,src=${HOME}/.codex,dst=/credentials/codex,readonly")
fi
if [[ -d "${HOME}/.claude" ]]; then
    docker_args+=(--mount "type=bind,src=${HOME}/.claude,dst=/credentials/claude,readonly")
fi
if [[ -d "${HOME}/.ssh" ]]; then
    docker_args+=(--mount "type=bind,src=${HOME}/.ssh,dst=/credentials/ssh,readonly")
fi
if [[ -f "$PROJECT_ROOT/.env" ]]; then
    docker_args+=(--env-file "$PROJECT_ROOT/.env")
fi
if command -v nvidia-smi >/dev/null 2>&1; then
    docker_args+=(--gpus all)
fi

docker_command=(docker run "${docker_args[@]}" "$IMAGE_NAME" "${cli_args[@]}")
if (( ${#forwarded[@]} > 0 )); then
    docker_command+=("${forwarded[@]}")
fi
"${docker_command[@]}"
