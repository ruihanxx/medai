#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE_NAME="${MEDAI_IMAGE:-medai:local}"
DOCKER_PLATFORM="linux/amd64"
MODEL_CACHE="${MEDAI_MODEL_CACHE:-$PROJECT_ROOT/.medai/mineru}"
MODEL_CONFIG="$MODEL_CACHE/mineru.json"
MODEL_MARKER="$MODEL_CACHE/.medai-image-id"
MINERU_VENV="$MODEL_CACHE/.venv"

if [[ "${1:-}" == "init" ]]; then
    shift
    if [[ $# -ne 0 ]]; then
        echo "ERROR: ./medai init does not accept additional arguments" >&2
        exit 2
    fi

    model_source="${MEDAI_MINERU_MODEL_SOURCE:-auto}"
    if [[ "$model_source" != "auto" && "$model_source" != "huggingface" && "$model_source" != "modelscope" ]]; then
        echo "ERROR: MEDAI_MINERU_MODEL_SOURCE must be auto, huggingface, or modelscope" >&2
        exit 2
    fi
    host_is_apple_silicon=false
    if [[ "$(uname -s)" == "Darwin" ]]; then
        macos_arch="$(uname -m)"
        macos_translated="$(sysctl -in sysctl.proc_translated 2>/dev/null || true)"
        if [[ "$macos_arch" == "arm64" || "$macos_translated" == "1" ]]; then
            host_is_apple_silicon=true
        fi
    fi
    host_python_explicit=false
    if [[ -n "${MEDAI_MINERU_PYTHON:-}" ]]; then
        host_python="$MEDAI_MINERU_PYTHON"
        host_python_explicit=true
    else
        host_python="python3"
    fi
    host_python_info=""
    if command -v "$host_python" >/dev/null 2>&1; then
        if ! host_python_info="$("$host_python" -c 'import platform, sys; print(f"{sys.version_info.major}.{sys.version_info.minor}:{platform.machine()}")')"; then
            echo "ERROR: Could not inspect host Python: $host_python" >&2
            exit 2
        fi
    fi
    host_python_version="${host_python_info%%:*}"
    host_python_arch="${host_python_info##*:}"
    host_python_major="${host_python_version%%.*}"
    host_python_minor="${host_python_version#*.}"
    host_python_is_supported=false
    if [[ -n "$host_python_info" ]] \
        && (( host_python_major > 3 || (host_python_major == 3 && host_python_minor >= 10) )); then
        host_python_is_supported=true
    fi
    if [[ "$host_is_apple_silicon" == "true" \
        && "$host_python_arch" != "arm64" && "$host_python_arch" != "arm64e" ]]; then
        host_python_is_supported=false
    fi
    if [[ "$host_python_explicit" == "false" && "$host_is_apple_silicon" == "true" \
        && "$host_python_is_supported" == "false" ]]; then
        native_python="/opt/homebrew/opt/python@3.12/bin/python3.12"
        if [[ ! -x "$native_python" ]]; then
            native_brew="/opt/homebrew/bin/brew"
            if [[ ! -x "$native_brew" ]]; then
                echo "ERROR: A native arm64 Python is required. Install native Homebrew from https://brew.sh, then rerun ./medai init." >&2
                exit 2
            fi
            printf 'Installing native Python 3.12 with Homebrew.\n'
            if ! "$native_brew" install python@3.12; then
                echo "ERROR: Homebrew could not install Python 3.12." >&2
                exit 1
            fi
        fi
        host_python="$native_python"
        if ! host_python_info="$("$host_python" -c 'import platform, sys; print(f"{sys.version_info.major}.{sys.version_info.minor}:{platform.machine()}")')"; then
            echo "ERROR: Could not inspect installed native Python: $host_python" >&2
            exit 1
        fi
        host_python_version="${host_python_info%%:*}"
        host_python_arch="${host_python_info##*:}"
        host_python_major="${host_python_version%%.*}"
        host_python_minor="${host_python_version#*.}"
    fi
    if [[ -z "$host_python_info" ]]; then
        echo "ERROR: Host Python is not available: $host_python" >&2
        exit 2
    fi
    if (( host_python_major < 3 || (host_python_major == 3 && host_python_minor < 10) )); then
        echo "ERROR: Host Python must be version 3.10 or newer: $host_python ($host_python_version)" >&2
        exit 2
    fi
    if [[ "$host_is_apple_silicon" == "true" \
        && "$host_python_arch" != "arm64" && "$host_python_arch" != "arm64e" ]]; then
        echo "ERROR: Apple Silicon requires a native arm64 Python for MinerU; $host_python is $host_python_arch (Rosetta)." >&2
        echo "Install a native Python 3.10+ and rerun with MEDAI_MINERU_PYTHON=/path/to/python3 ./medai init" >&2
        exit 2
    fi

    mkdir -p "$MODEL_CACHE/home"
    MODEL_CACHE="$(cd "$MODEL_CACHE" && pwd -P)"
    MODEL_CONFIG="$MODEL_CACHE/mineru.json"
    MODEL_MARKER="$MODEL_CACHE/.medai-image-id"
    MINERU_VENV="$MODEL_CACHE/.venv"

    if [[ -x "$MINERU_VENV/bin/python" ]]; then
        if ! venv_python_info="$("$MINERU_VENV/bin/python" -c 'import platform, sys; print(f"{sys.version_info.major}.{sys.version_info.minor}:{platform.machine()}")')"; then
            echo "ERROR: Could not inspect existing host MinerU environment: $MINERU_VENV" >&2
            exit 2
        fi
        if [[ "$venv_python_info" != "$host_python_info" ]]; then
            incompatible_venv="${MINERU_VENV}.incompatible-${venv_python_info//:/-}"
            if [[ -e "$incompatible_venv" ]]; then
                incompatible_venv="${incompatible_venv}-$(date -u +%Y%m%dT%H%M%SZ)"
            fi
            printf 'Archiving incompatible host MinerU environment to: %s\n' "$incompatible_venv"
            mv "$MINERU_VENV" "$incompatible_venv"
        fi
    fi
    if [[ ! -x "$MINERU_VENV/bin/python" ]]; then
        printf 'Creating host MinerU environment: %s\n' "$MINERU_VENV"
        "$host_python" -m venv "$MINERU_VENV"
        if [[ -n "${MEDAI_PYPI_INDEX:-}" ]]; then
            "$MINERU_VENV/bin/python" -m pip install \
                --index-url "$MEDAI_PYPI_INDEX" --upgrade pip
        else
            "$MINERU_VENV/bin/python" -m pip install --upgrade pip
        fi
    fi
    printf 'Installing host MinerU runtime.\n'
    if [[ -n "${MEDAI_PYPI_INDEX:-}" ]]; then
        "$MINERU_VENV/bin/python" -m pip install \
            --index-url "$MEDAI_PYPI_INDEX" \
            "accelerate>=1.5.1,<2" "mineru[pipeline]>=3,<4" "six>=1.16,<2"
    else
        "$MINERU_VENV/bin/python" -m pip install \
            "accelerate>=1.5.1,<2" "mineru[pipeline]>=3,<4" "six>=1.16,<2"
    fi

    printf 'Building MedAI image: %s\n' "$IMAGE_NAME"
    docker build --platform "$DOCKER_PLATFORM" \
        -f "$PROJECT_ROOT/docker/Dockerfile" \
        -t "$IMAGE_NAME" \
        "$PROJECT_ROOT"

    printf 'Initializing MinerU models in: %s\n' "$MODEL_CACHE"
    HOME="$MODEL_CACHE/home" \
        HF_HOME="$MODEL_CACHE/huggingface" \
        MODELSCOPE_CACHE="$MODEL_CACHE/modelscope" \
        MINERU_TOOLS_CONFIG_JSON="$MODEL_CONFIG" \
        "$MINERU_VENV/bin/mineru-models-download" \
        --source "$model_source" \
        --model_type all

    if [[ ! -s "$MODEL_CONFIG" ]]; then
        echo "ERROR: MinerU initialization completed without creating $MODEL_CONFIG" >&2
        exit 1
    fi
    image_id="$(docker image inspect "$IMAGE_NAME" --format '{{.Id}}')"
    printf 'host-mineru:%s\n' "$image_id" > "$MODEL_MARKER"
    printf 'MedAI initialization completed.\n'
    exit 0
fi

paper=""
repo=""
data=""
provider="codex"
siliconflow_config=""
requested_output=""
forwarded=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --paper)
            paper="$(realpath "$2")"
            shift 2
            ;;
        --repo)
            repo="$(realpath "$2")"
            shift 2
            ;;
        --data)
            data="$(realpath "$2")"
            shift 2
            ;;
        --output)
            if [[ $# -lt 2 ]]; then
                echo "ERROR: --output requires a run directory" >&2
                exit 2
            fi
            requested_output="$2"
            if [[ -z "$requested_output" ]]; then
                echo "ERROR: --output requires a run directory" >&2
                exit 2
            fi
            shift 2
            ;;
        --output=*)
            requested_output="${1#--output=}"
            if [[ -z "$requested_output" ]]; then
                echo "ERROR: --output requires a run directory" >&2
                exit 2
            fi
            shift
            ;;
        --provider)
            provider="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"
            shift 2
            ;;
        --siliconflow-config)
            siliconflow_config="$(realpath "$2")"
            shift 2
            ;;
        --help|-h)
            cat <<'EOF'
Usage:
  ./medai init
  ./medai --paper PAPER.pdf --provider PROVIDER [options]

Options:
  --repo DIR
  --data DIR
  --siliconflow-config FILE
  --codex-model MODEL
  --codex-reasoning-effort EFFORT
  --smart-replicate
  --output RUN_DIR              Resume an existing run under ./runs
  --help
EOF
            exit 0
            ;;
        *)
            forwarded+=("$1")
            shift
            ;;
    esac
done

if [[ -z "$paper" || ! -f "$paper" ]]; then
    echo "ERROR: --paper must be an existing PDF file" >&2
    exit 2
fi
if [[ -n "$repo" && ! -d "$repo" ]]; then
    echo "ERROR: --repo must be an existing directory" >&2
    exit 2
fi
if [[ -n "$data" && ! -d "$data" ]]; then
    echo "ERROR: --data must be an existing directory" >&2
    exit 2
fi
if [[ "$provider" != "claude" && "$provider" != "codex" && "$provider" != "codex-siliconflow" ]]; then
    echo "ERROR: unsupported provider: $provider" >&2
    exit 2
fi
if [[ "$provider" == "codex-siliconflow" && ( -z "$siliconflow_config" || ! -f "$siliconflow_config" ) ]]; then
    echo "ERROR: codex-siliconflow requires --siliconflow-config" >&2
    exit 2
fi
if [[ ! -x "$MINERU_VENV/bin/mineru" ]]; then
    echo "ERROR: Host MinerU environment is not initialized; run ./medai init first" >&2
    exit 2
fi
if ! image_id="$(docker image inspect "$IMAGE_NAME" --format '{{.Id}}' 2>/dev/null)"; then
    echo "ERROR: MedAI is not initialized; run ./medai init first" >&2
    exit 2
fi
if [[ ! -s "$MODEL_CONFIG" || ! -s "$MODEL_MARKER" ]]; then
    echo "ERROR: MinerU models are not initialized; run ./medai init first" >&2
    exit 2
fi
initialized_image_id="$(<"$MODEL_MARKER")"
if [[ "$initialized_image_id" != "host-mineru:$image_id" ]]; then
    echo "ERROR: MedAI image or host MinerU initialization changed; run ./medai init again" >&2
    exit 2
fi
MODEL_CACHE="$(cd "$MODEL_CACHE" && pwd -P)"
MINERU_VENV="$MODEL_CACHE/.venv"
paper_name="$(basename "$paper")"
paper_name="${paper_name%.*}"
paper_name="$(printf '%s' "$paper_name" | tr -cs '[:alnum:]_.-' '_' | sed 's/^_*//; s/_*$//')"
[[ -n "$paper_name" ]] || paper_name="paper"
mkdir -p "$PROJECT_ROOT/runs"
runs_root="$(cd "$PROJECT_ROOT/runs" && pwd -P)"
if [[ -n "$requested_output" ]]; then
    if [[ ! -d "$requested_output" ]]; then
        echo "ERROR: --output must be an existing MedAI run directory" >&2
        exit 2
    fi
    output="$(cd "$requested_output" && pwd -P)"
    if [[ "$output" != "$runs_root/"* ]]; then
        echo "ERROR: --output must be an existing directory under $runs_root" >&2
        exit 2
    fi
    if [[ ! -f "$output/manifest.json" ]]; then
        echo "ERROR: --output does not contain manifest.json: $output" >&2
        exit 2
    fi
    printf 'Resuming run output: %s\n' "$output"
else
    run_prefix="$(date -u +%Y%m%dT%H%M%SZ)_${paper_name}"
    output="$runs_root/$run_prefix"
    run_suffix=1
    while ! mkdir "$output" 2>/dev/null; do
        output="$runs_root/${run_prefix}_$run_suffix"
        run_suffix=$((run_suffix + 1))
    done
    printf 'Run output: %s\n' "$output"
fi

host_mineru_output=""
cleanup_host_mineru_output() {
    if [[ -n "$host_mineru_output" && -d "$host_mineru_output" ]]; then
        rm -rf -- "$host_mineru_output"
    fi
}
trap cleanup_host_mineru_output EXIT

if [[ ! -s "$output/preprocessing/paper.md" || ! -d "$output/preprocessing/artifacts" ]]; then
    host_mineru_output="$(mktemp -d "${TMPDIR:-/tmp}/medai-mineru.XXXXXX")"
    printf 'Running MinerU natively on the host.\n'
    HOME="$MODEL_CACHE/home" \
        HF_HOME="$MODEL_CACHE/huggingface" \
        MODELSCOPE_CACHE="$MODEL_CACHE/modelscope" \
        MINERU_MODEL_SOURCE=local \
        MINERU_TOOLS_CONFIG_JSON="$MODEL_CONFIG" \
        "$MINERU_VENV/bin/mineru" -p "$paper" -o "$host_mineru_output"
fi

docker_args=(
    --rm
    --platform "$DOCKER_PLATFORM"
    --env "MEDAI_HOST_PAPER=$paper"
    --mount "type=bind,src=$paper,dst=/workspace/inputs/paper.pdf,readonly"
    --mount "type=bind,src=$output,dst=/workspace/output"
)
cli_args=(
    --paper /workspace/inputs/paper.pdf
    --provider "$provider"
    --output /workspace/output
)

if [[ -n "$host_mineru_output" ]]; then
    docker_args+=(--env "MEDAI_MINERU_OUTPUT=/workspace/mineru-output")
    docker_args+=(--mount "type=bind,src=$host_mineru_output,dst=/workspace/mineru-output,readonly")
fi

if [[ -n "$repo" ]]; then
    docker_args+=(--env "MEDAI_HOST_REPO=$repo")
    docker_args+=(--mount "type=bind,src=$repo,dst=/workspace/repo,readonly")
    cli_args+=(--repo /workspace/repo)
fi
if [[ -n "$data" ]]; then
    docker_args+=(--env "MEDAI_HOST_DATA=$data")
    docker_args+=(--mount "type=bind,src=$data,dst=/workspace/data,readonly")
    cli_args+=(--data /workspace/data)
fi
if [[ -n "$siliconflow_config" ]]; then
    docker_args+=(--mount "type=bind,src=$siliconflow_config,dst=/run/secrets/siliconflow.env,readonly")
    cli_args+=(--siliconflow-config /run/secrets/siliconflow.env)
fi
if [[ -d "${HOME}/.codex" ]]; then
    docker_args+=(--mount "type=bind,src=${HOME}/.codex,dst=/credentials/codex,readonly")
fi
if [[ -d "${HOME}/.claude" ]]; then
    docker_args+=(--mount "type=bind,src=${HOME}/.claude,dst=/credentials/claude,readonly")
fi
if [[ -d "${HOME}/.ssh" ]]; then
    docker_args+=(--mount "type=bind,src=${HOME}/.ssh,dst=/credentials/ssh,readonly")
fi
if [[ -f "$PROJECT_ROOT/.env" ]]; then
    docker_args+=(--env-file "$PROJECT_ROOT/.env")
fi
if command -v nvidia-smi >/dev/null 2>&1; then
    docker_args+=(--gpus all)
fi

docker_command=(docker run "${docker_args[@]}" "$IMAGE_NAME" "${cli_args[@]}")
if (( ${#forwarded[@]} > 0 )); then
    docker_command+=("${forwarded[@]}")
fi
"${docker_command[@]}"
